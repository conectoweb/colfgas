# ===================================================================
# COLFGAS CONSTRUCCIONES S.A.S. - Variables de Entorno de Configuración
# ===================================================================
# Copia este archivo a .env.local para desarrollo local:
#   cp .env.example .env.local
#
# NOTA IMPORTANTE: Los valores marcados con [CONFIRMAR CON EL CLIENTE]
# deben ser validados y reemplazados con la información oficial antes
# del lanzamiento a producción en Hostinger.
# ===================================================================

# Dominio público canónico del sitio web (sin barra final)
NEXT_PUBLIC_SITE_URL=https://colfgas.com.co

# Datos comerciales y de contacto [CONFIRMAR CON EL CLIENTE]
NEXT_PUBLIC_COMPANY_NAME="COLFGAS CONSTRUCCIONES S.A.S."
NEXT_PUBLIC_COMPANY_NIT="[CONFIRMAR NIT CON EL CLIENTE]"
NEXT_PUBLIC_COMPANY_PHONE="+57 320 827 1724"
NEXT_PUBLIC_COMPANY_PHONE_ALT="+57 318 419 1099"
NEXT_PUBLIC_COMPANY_WHATSAPP="573208271724"
NEXT_PUBLIC_COMPANY_EMAIL="contacto@colfgas.com.co"
NEXT_PUBLIC_COMPANY_ADDRESS="Calle 90 Sur # 4F-33 Este, Bogotá, Colombia"
NEXT_PUBLIC_COMPANY_HOURS="Lunes a Viernes: 7:30 a.m. a 5:30 p.m. - Sábados: 8:00 a.m. a 1:00 p.m."

# Analítica y Medición (Opcional - Dejar vacío hasta que el cliente proporcione accesos)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""

# Endpoint externo de formulario de contacto (opcional para hosting estático en Hostinger)
# Ejemplo: Formspree, Web3Forms o endpoint de webhook corporativo
NEXT_PUBLIC_FORM_ENDPOINT=""
