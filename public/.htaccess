# ===================================================================
# Hostinger Apache / LiteSpeed Configuration for COLFGAS CONSTRUCCIONES
# ===================================================================

# 1. Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect trailing slash to non-slash or vice-versa
  # Clean URL routing for exported Next.js HTML files
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 2. Custom 404 Error Page
ErrorDocument 404 /404.html

# 3. Cache Control for Performance (Core Web Vitals)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML files - revalidate frequently
  ExpiresByType text/html "access plus 0 seconds"

  # Static CSS, JavaScript, and Web Fonts
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # Images and Favicons
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# 4. Security Headers
<IfModule mod_headers.c>
  # Previene que el navegador interprete archivos con tipos MIME diferentes al declarado (MIME-sniffing)
  Header set X-Content-Type-Options "nosniff"

  # Protección contra ataques de clickjacking limitando el renderizado en iframes
  Header set X-Frame-Options "SAMEORIGIN"

  # Política de seguridad de contenido (CSP) estricta acorde a los recursos propios del sitio
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://wa.me; upgrade-insecure-requests;"

  # HSTS activo para conexiones HTTPS sin includeSubDomains ni preload
  Header set Strict-Transport-Security "max-age=31536000"

  # Política de control de referenciador
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Restricción de APIs y permisos del navegador innecesarios
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Protección XSS para navegadores compatibles
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
